function %float_bitops(f64, f64) -> f64, f64, f64 {
block0(v0: f64, v1: f64):
    v2 = bxor v0, v1
    v3 = band v0, v1
    v4 = bnot v1
    return v2, v3, v4
}
; Flipping and keeping the sign bit: -0.0 has only the sign set.
; run: %float_bitops(0x1.8p0, -0x0.0) == [-0x1.8p0, 0x0.0, +NaN]

