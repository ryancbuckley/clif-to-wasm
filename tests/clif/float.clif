function %farith(f64, f64) -> f64, f64, f64, f64 {
block0(v0: f64, v1: f64):
    v2 = fadd v0, v1
    v3 = fsub v0, v1
    v4 = fmul v0, v1
    v5 = fdiv v0, v1
