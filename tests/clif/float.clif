function %funary(f32) -> f32, f32, f32, f32, f32, f32 {
block0(v0: f32):
    v1 = fneg v0
    v2 = fabs v0
    v3 = floor v0
    v4 = ceil v0
    v5 = trunc v0
    v6 = nearest v0
