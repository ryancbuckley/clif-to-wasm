function %fcmp(f32, f32) -> i8, i8, i8, i8, i8, i8, i8 {
block0(v0: f32, v1: f32):
    v2 = fcmp uno v0, v1
    v3 = fcmp ord v0, v1
    v4 = fcmp one v0, v1
    v5 = fcmp ueq v0, v1
    v6 = fcmp ult v0, v1
    v7 = fcmp ne v0, v1
    v8 = fcmp lt v0, v1
    return v2, v3, v4, v5, v6, v7, v8
}
; run: %fcmp(0x1.0, 0x2.0) == [0, 1, 1, 0, 1, 1, 1]
; run: %fcmp(0x1.0, 0x1.0) == [0, 1, 0, 1, 0, 0, 0]
; run: %fcmp(+NaN, 0x1.0) == [1, 0, 0, 1, 1, 1, 0]

