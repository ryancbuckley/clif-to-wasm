function %store_load(i32, i64) -> i64 {
block0(v0: i32, v1: i64):
    store v1, v0+8
    v2 = load.i64 v0+8
    return v2
}
; run: %store_load(16, 0x1122334455667788) == 0x1122334455667788

; The second load must not be folded past the store.
function %load_store_order(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 5
    store v1, v0
    v2 = load.i32 v0
    v3 = iconst.i32 7
    store v3, v0
    v4 = iadd v2, v3
    return v4
}
; run: %load_store_order(100) == 12

; Two loads used in swapped order: one must go through a local.
function %load_order(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 3
    store v1, v0
    v2 = iconst.i32 4
    store v2, v0+4
    v3 = load.i32 v0
    v4 = load.i32 v0+4
    v5 = isub v4, v3
    return v5
}
; run: %load_order(200) == 1

function %narrow_mem(i32) -> i32, i32, i64, i8 {
block0(v0: i32):
    v1 = iconst.i32 0xfffffe80
    store v1, v0
    v2 = uload8.i32 v0
    v3 = sload16.i32 v0
    v4 = sload8.i64 v0
    v5 = load.i8 v0
    return v2, v3, v4, v5
}
; run: %narrow_mem(64) == [0x80, -384, -128, 0x80]

