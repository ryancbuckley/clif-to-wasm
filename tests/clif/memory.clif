function %stack_slots(i32, i32) -> i32 {
    ss0 = explicit_slot 4
    ss1 = explicit_slot 8, align = 8
block0(v0: i32, v1: i32):
    v10 = stack_addr.i32 ss0
    store v0, v10
    v2 = stack_addr.i32 ss1
    store v1, v2+4
    v3 = load.i32 v10
    v4 = load.i32 v2+4
    v5 = isub v3, v4
    return v5
}
; run: %stack_slots(10, 3) == 7

function %trap_load(i32) -> i32 {
block0(v0: i32):
    v1 = load.i32 v0
    v2 = iconst.i32 1
    v3 = iadd v1, v2
    return v3
}
; run: %trap_load(0) == 1
