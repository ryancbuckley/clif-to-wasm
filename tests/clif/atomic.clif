block0(v0: i8, v1: i8, v2: i8):
    v3 = stack_addr.i64 ss0
    store.i8 big v0, v3
    v4 = atomic_cas.i8 big v3, v1, v2
    v5 = load.i8 big v3
    return v4, v5
}
