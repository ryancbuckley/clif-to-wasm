test run

; Atomic operations on a stack slot. These check the values computed, not
; atomicity. `nand` and the min/max operations have no wasm instruction and
; use a compare-exchange loop, as do big-endian read-modify-writes.


function %rmw_add_i8(i8, i8) -> i8, i8 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = stack_addr.i64 ss0
    store.i8 v0, v2
    v3 = atomic_rmw.i8 add v2, v1
    v4 = load.i8 v2
    return v3, v4
}
; run: %rmw_add_i8(0x05, 0x03) == [0x05, 0x08]
; run: %rmw_add_i8(0x7f, 0x80) == [0x7f, 0xff]
; run: %rmw_add_i8(0xff, 0x01) == [0xff, 0x00]
; run: %rmw_add_i8(0x80, 0x7f) == [0x80, 0xff]

function %rmw_sub_i8(i8, i8) -> i8, i8 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = stack_addr.i64 ss0
    store.i8 v0, v2
    v3 = atomic_rmw.i8 sub v2, v1
    v4 = load.i8 v2
    return v3, v4
}
; run: %rmw_sub_i8(0x05, 0x03) == [0x05, 0x02]
; run: %rmw_sub_i8(0x7f, 0x80) == [0x7f, 0xff]
; run: %rmw_sub_i8(0xff, 0x01) == [0xff, 0xfe]
; run: %rmw_sub_i8(0x80, 0x7f) == [0x80, 0x01]

function %rmw_and_i8(i8, i8) -> i8, i8 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = stack_addr.i64 ss0
    store.i8 v0, v2
    v3 = atomic_rmw.i8 and v2, v1
    v4 = load.i8 v2
    return v3, v4
}
; run: %rmw_and_i8(0x05, 0x03) == [0x05, 0x01]
; run: %rmw_and_i8(0x7f, 0x80) == [0x7f, 0x00]
; run: %rmw_and_i8(0xff, 0x01) == [0xff, 0x01]
; run: %rmw_and_i8(0x80, 0x7f) == [0x80, 0x00]

function %rmw_nand_i8(i8, i8) -> i8, i8 {
    ss0 = explicit_slot 8, align = 8

block0(v0: i8, v1: i8):
    v2 = stack_addr.i64 ss0
    store.i8 v0, v2
    v3 = atomic_rmw.i8 nand v2, v1
    v4 = load.i8 v2
    return v3, v4
}
; run: %rmw_nand_i8(0x05, 0x03) == [0x05, 0xfe]
; run: %rmw_nand_i8(0x7f, 0x80) == [0x7f, 0xff]
; run: %rmw_nand_i8(0xff, 0x01) == [0xff, 0xfe]
; run: %rmw_nand_i8(0x80, 0x7f) == [0x80, 0xff]

