; A by-value struct argument (`sarg`) is copied by the caller: the callee
; gets the address of its own copy.

function %callee(i64 sarg(24)) -> i64 {
block0(v0: i64):
    v1 = load.i64 v0
    v2 = load.i64 v0+16
    v3 = iadd v1, v2
