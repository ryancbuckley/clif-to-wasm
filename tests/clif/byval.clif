    v4 = iconst.i64 -1
    store v4, v0
    store v4, v0+8
    return v3
}

function %caller(i64, i64) -> i64 {
    fn0 = %callee(i64 sarg(24)) -> i64
    ss0 = explicit_slot 24, align = 8
block0(v0: i64, v1: i64):
    v3 = stack_addr.i64 ss0
    store v0, v3
    v2 = iconst.i64 100
    store v2, v3+8
    store v1, v3+16
    v4 = call fn0(v3)
    ; The struct is unchanged after the call.
    v5 = load.i64 v3
    v6 = load.i64 v3+8
    v7 = iadd v4, v5
    v8 = iadd v7, v6
    return v8
}
