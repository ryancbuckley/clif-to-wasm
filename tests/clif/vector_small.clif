; run: %bitcast_f64_i32x2(-0x1.0p0) == [0 0xbff00000]

function %f32x2_arith(f32x2, f32x2) -> f32x2 {
block0(v0: f32x2, v1: f32x2):
    v2 = fmul v0, v1
    v3 = fadd v2, v0
    return v3
}
; run: %f32x2_arith([0x1.0p1 -0x1.8p0], [0x1.0p2 0x1.0p1]) == [0x1.4p3 -0x1.2p2]
