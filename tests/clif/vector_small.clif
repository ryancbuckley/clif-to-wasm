test run

; Vectors narrower than 128 bits live in the low bytes of a v128; the other
; bytes hold leftovers. These tests make the leftovers differ from the
; used lanes wherever an operation could see them.

function %store_i32x2(i32x2) -> i64, i64 {
    ss0 = explicit_slot 16

block0(v0: i32x2):
    v1 = stack_addr.i64 ss0
    v2 = iconst.i64 -1
    store v2, v1
    store v2, v1+8
    store v0, v1
    v3 = load.i64 v1
    v4 = load.i64 v1+8
    return v3, v4
}
; run: %store_i32x2([1 2]) == [0x00000002_00000001, -1]

function %store_i16x2(i16x2) -> i64 {
    ss0 = explicit_slot 8

block0(v0: i16x2):
    v1 = stack_addr.i64 ss0
    v2 = iconst.i64 -1
    store v2, v1
    store v0, v1
    v3 = load.i64 v1
    return v3
}
; run: %store_i16x2([0x1234 0x5678]) == 0xffffffff_56781234

function %store_i8x2(i8x2) -> i64 {
    ss0 = explicit_slot 8

block0(v0: i8x2):
    v1 = stack_addr.i64 ss0
    v2 = iconst.i64 -1
    store v2, v1
    store v0, v1
    v3 = load.i64 v1
    return v3
}
; run: %store_i8x2([0x12 0x34]) == 0xffffffff_ffff3412

function %load_i16x2(i64) -> i16x2 {
    ss0 = explicit_slot 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = load.i16x2 v1
    return v2
}
; run: %load_i16x2(0x11112222_33334444) == [0x4444 0x3333]

function %load_i8x2(i64) -> i8x2 {
    ss0 = explicit_slot 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = load.i8x2 v1
    return v2
}
; run: %load_i8x2(0x11223344_55667788) == [0x88 0x77]

; A loaded i32x2 has zero upper lanes, which must not count as false.
function %vall_true_loaded(i64) -> i8 {
    ss0 = explicit_slot 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = load.i32x2 v1
    v3 = vall_true v2
    return v3
}
; run: %vall_true_loaded(0x00000001_00000001) == 1
; run: %vall_true_loaded(0x00000001_00000000) == 0

; splat fills all four i32 lanes, the loaded vector only two: their
; difference has leftovers of 5 in the upper lanes.
function %vany_true_leftovers(i64) -> i8 {
    ss0 = explicit_slot 8

block0(v0: i64):
    v1 = stack_addr.i64 ss0
    store v0, v1
    v2 = load.i32x2 v1
    v3 = iconst.i32 5
    v4 = splat.i32x2 v3
    v5 = isub v4, v2
    v6 = vany_true v5
    return v6
}
; run: %vany_true_leftovers(0x00000005_00000005) == 0
; run: %vany_true_leftovers(0x00000005_00000004) == 1

function %vhigh_bits_leftovers(i32) -> i8 {
block0(v0: i32):
    v1 = splat.i32x2 v0
    v2 = vhigh_bits.i8 v1
    return v2
}
; run: %vhigh_bits_leftovers(-1) == 3
; run: %vhigh_bits_leftovers(1) == 0

function %iadd_pairwise_i16x4(i16x4, i16x4) -> i16x4 {
block0(v0: i16x4, v1: i16x4):
    v2 = iadd_pairwise v0, v1
    return v2
}
; run: %iadd_pairwise_i16x4([1 2 3 4], [10 20 30 40]) == [3 7 30 70]

