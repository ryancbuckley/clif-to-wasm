function %double(i32) -> i32 {
block0(v0: i32):
    v1 = iadd v0, v0
    return v1
}

function %call_it(i32) -> i32 {
    fn0 = %double(i32) -> i32
block0(v0: i32):
    v1 = call fn0(v0)
    v2 = iconst.i32 1
    v3 = iadd v1, v2
    return v3
}
; run: %call_it(20) == 41

function %pair(i64) -> i64, i64 {
