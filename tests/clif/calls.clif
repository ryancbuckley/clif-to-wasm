; The callee must not see the caller's stack slot clobbered.
function %use_slot(i32) -> i32 {
    ss0 = explicit_slot 4
block0(v0: i32):
    v2 = stack_addr.i32 ss0
    store v0, v2
    v1 = load.i32 v2
    return v1
}

function %slot_across_call(i32) -> i32 {
    ss0 = explicit_slot 4
    fn0 = %use_slot(i32) -> i32
block0(v0: i32):
    v5 = stack_addr.i32 ss0
    store v0, v5
    v1 = iconst.i32 99
    v2 = call fn0(v1)
    v3 = load.i32 v5
    v4 = iadd v2, v3
    return v4
}
; run: %slot_across_call(1) == 100
